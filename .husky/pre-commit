#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# lint js and vue files
npx --no-install lint-staged

# lint only staged ruby files
#
# O pipe direto para `xargs` rodava `bundle` mesmo sem nenhum .rb no stage — o xargs
# executa o comando uma vez com lista vazia. Num commit so de JS a partir de uma maquina
# sem Ruby no PATH (aqui o Ruby vive no container), isso derrubava o hook com exit 127.
# `--diff-filter=d` ja descarta arquivo apagado, que era o papel do `ls -1`.
ruby_files=$(git diff --name-only --cached --diff-filter=d | grep '\.rb$' || true)

if [ -n "$ruby_files" ]; then
  echo "$ruby_files" | xargs bundle exec rubocop --force-exclusion
fi

